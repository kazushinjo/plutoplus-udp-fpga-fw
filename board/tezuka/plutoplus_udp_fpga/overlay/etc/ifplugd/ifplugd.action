#!/bin/sh
# Replaces tezuka's board/tezuka/common/overlay_tezuka/etc/ifplugd/ifplugd.action.
# tezuka's version flushes the address when the link goes down and only
# restores it with DHCP when the link comes back, so with a static
# ipaddr_eth the address was lost for good after any link drop longer than
# ifplugd's delay (the LAN stopped answering until a reboot).
# Here the address is never removed on link down (static or DHCP). On link
# up a static address and default route are put back if missing, and DHCP
# renews the lease as before.
ETH_IPADDR=$(fw_printenv -n ipaddr_eth 2> /dev/null)

if [ -z "$ETH_IPADDR" ] || [ "$ETH_IPADDR" = "dhcp" ]; then
	case "$2" in
	up)
		/sbin/udhcpc -i "$1" -t 15 -T 4 -n -q -x hostname:"$(hostname)"
		;;
	down)
		# keep the address; udhcpc replaces it on the next lease if it changes
		;;
	esac
	exit 0
fi

case "$2" in
up)
	MASK=$(fw_printenv -n netmask_eth 2> /dev/null)
	[ -n "$MASK" ] || MASK=255.255.255.0
	GW=$(fw_printenv -n gateway_eth 2> /dev/null)
	if ! /sbin/ip -4 addr show dev "$1" | grep -q "inet ${ETH_IPADDR}/"; then
		/sbin/ip addr add "${ETH_IPADDR}/${MASK}" dev "$1"
	fi
	[ -n "$GW" ] && /sbin/ip route replace default via "$GW" dev "$1"
	logger -t ifplugd.action "$1 up: static ${ETH_IPADDR}/${MASK} gw ${GW:-none}"
	;;
down)
	# keep the static address; nothing to do
	;;
esac
exit 0
