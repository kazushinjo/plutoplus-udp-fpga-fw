#!/bin/sh
# pluto_dvb stand-in for the plutoplus_dvb bitstream (DVB-S2 encoder in the
# FPGA). Installed as /root/pluto_dvb by board/tezuka/plutoplus_udp_fpga/post-build.sh.
#
# Takes the same options as the software pluto_dvb used by udpts.sh and
# rtmppluto.sh, hands the modulation settings to pluto_stream /
# pluto_mqtt_ctrl over MQTT and forwards the TS (stdin, or -i <file>) to
# pluto_stream's UDP input. -d (TS bitrate) is still answered by the software
# pluto_dvb (pluto_dvb.sw), which only computes it.
#
# Not supported by the FPGA path, ignored: -r (roll-off), -T, -L, -P, -q.

SW=/root/pluto_dvb.sw
TS_IN=127.0.0.1:1314

MODE=DVBS2 CONSTEL=QPSK SR="" FEC=12 FREQ="" GAIN="" PILOTS=0 FRAME=long INPUT=""
ARGS="$*"
while getopts "m:c:s:f:t:g:T:L:P:r:i:q:pvd" opt; do
	case "$opt" in
	m) MODE=$OPTARG ;;
	c) CONSTEL=$OPTARG ;;
	s) SR=$OPTARG ;;
	f) FEC=$OPTARG ;;
	t) FREQ=$OPTARG ;;
	g) GAIN=$OPTARG ;;
	i) INPUT=$OPTARG ;;
	p) PILOTS=1 ;;
	v) FRAME=short ;;
	d) exec $SW $ARGS ;;
	*) ;;
	esac
done

CALL=$(fw_printenv -n call 2>/dev/null)
[ -z "$CALL" ] && CALL=nocall
ROOT="cmd/pluto/$CALL"

pub() {
	mosquitto_pub -h 127.0.0.1 -t "$ROOT/$1" -m "$2"
}

# The AD9361 can be left in the "alert" state (synthesizers on, neither RX nor
# TX running) when another iio client (a receiver on this Pluto) changes the
# sample rate / FIR while pluto_stream reconfigures the TX: the driver fails
# ("ADC clock below limit") and does not go back to FDD. Nothing is then
# transmitted although pluto_stream reports run 1 / mute 0. While this script
# is keying the transmitter, put it back to FDD whenever it is found in alert.
PHY=""
for d in /sys/bus/iio/devices/iio:device*; do
	[ "$(cat "$d/name" 2>/dev/null)" = ad9361-phy ] && PHY=$d && break
done
ensure_fdd() {
	[ -n "$PHY" ] || return 0
	if [ "$(cat "$PHY/ensm_mode" 2>/dev/null)" = alert ]; then
		echo fdd > "$PHY/ensm_mode" 2>/dev/null
		logger -t pluto_dvb "ad9361 ensm was alert while transmitting, set back to fdd"
	fi
}

[ -n "$INPUT" ] && exec <"$INPUT"

# Wait for the first TS packet before keying the transmitter, as the
# software pluto_dvb did: udpts.sh starts this as soon as it is waiting on
# UDP 8282, long before anything is sent.
FIRST=/tmp/pluto_dvb_first.$$
dd bs=188 count=1 of="$FIRST" 2>/dev/null
if [ ! -s "$FIRST" ]; then
	rm -f "$FIRST"
	exit 0
fi

# MQTT commands are not retained: make sure pluto_stream (S96plutostream,
# started after S90datv) and pluto_mqtt_ctrl are listening first.
i=0
while ! { pidof pluto_stream && pidof pluto_mqtt_ctrl; } >/dev/null 2>&1 && [ $i -lt 30 ]; do
	sleep 1
	i=$((i + 1))
done

case "$MODE" in
DVBS | dvbs | DVB-S) TXMODE=dvbs ;;
*) TXMODE=dvbs2-ts ;;
esac

configure() {
	pub tx/stream/run 0
	pub tx/stream/mode "$TXMODE"
	pub tx/dvbs2/tssourcemode 0
	pub tx/dvbs2/tssourceaddress "$TS_IN"
	pub tx/dvbs2/constel "$(echo "$CONSTEL" | tr 'A-Z' 'a-z')"
	pub tx/dvbs2/fec "$FEC"
	pub tx/dvbs2/frame "$FRAME"
	pub tx/dvbs2/pilots "$PILOTS"
	[ -n "$SR" ] && pub tx/dvbs2/sr "$SR"
	[ -n "$FREQ" ] && pub tx/frequency "$(awk -v f="$FREQ" 'BEGIN { printf "%.0f", f }')"
	[ -n "$GAIN" ] && pub tx/gain "$GAIN"
	pub tx/mute 0
	pub tx/stream/run 1
}

# Right after boot pluto_stream can miss these commands even though its process
# exists, and stays in passthrough. Check that the mode took, and resend.
mode_applied() {
	[ "$(mosquitto_sub -h 127.0.0.1 -C 1 -W 2 -t "dt/pluto/$CALL/tx/stream/mode" 2>/dev/null)" = "$TXMODE" ]
}

i=0
while [ $i -lt 5 ]; do
	configure
	sleep 1
	mode_applied && break
	i=$((i + 1))
done

ensure_fdd
# Keep checking while the TS is being forwarded; stops with this script
# (also when watchudp.sh kills it with killall -9 pluto_dvb).
PARENT=$$
( while kill -0 "$PARENT" 2>/dev/null; do sleep 2; ensure_fdd; done ) &
GUARD=$!

# Input ended (sender stopped, or the tsp in front was killed): unkey.
# udpts.sh / watchudp.sh restart the chain with "killall -9 tsp pluto_dvb"
# when settings.txt changes; the next run publishes the new settings.
# Same real-time buffering as the tsp in udpts.sh. With the default buffer tsp
# sends nothing until it has filled, which takes minutes at low bitrates.
{ cat "$FIRST"; rm -f "$FIRST"; cat; } | tsp -r --buffer-size-mb 0.01 --max-flushed-packets 100 --max-input-packets 50 -O ip "$TS_IN"
kill "$GUARD" 2>/dev/null
pub tx/stream/run 0
pub tx/mute 1
